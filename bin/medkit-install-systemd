#!/usr/bin/env bash
# Install (or refresh) the MedKit systemd user units.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="${HOME}/.config/systemd/user"
mkdir -p "${target}"
for unit in "${root}"/systemd/*.service "${root}"/systemd/*.timer; do
  install -m 0644 "${unit}" "${target}/"
  echo "installed $(basename "${unit}")"
done
systemctl --user daemon-reload
systemctl --user enable --now medkit-tick.timer medkit-vault.timer medkit-tray.service
systemctl --user --no-pager --plain list-timers | grep medkit || true
